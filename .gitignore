# compiled output
/dist
/node_modules
/build

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store
# Windows "downloaded from the internet" marker, surfaced as a real file
# through the WSL/UNC bridge.
*Zone.Identifier

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
# Ignore every .env variant, then re-allow the committed template. The broad
# pattern matters: `.env.production` holds real credentials and was not covered
# by the narrower `.env.production.local` rule below it.
.env
.env.*
!.env.example
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Valhalla. The Dockerfile, tile-build script and valhalla.json MUST be
# tracked or the image cannot be built from a clone. What stays out is the
# large binaries: the OSM extract (an input) and the built graph, both
# reproducible with valhalla/build-tiles.sh.
valhalla/custom_files/*.osm.pbf
valhalla/custom_files/*Zone.Identifier
valhalla/custom_files/valhalla_tiles/
valhalla/custom_files/valhalla_tiles.tar
valhalla/custom_files/admin_data/
valhalla/custom_files/timezone_data/
valhalla/custom_files/duplicateways.txt
valhalla/custom_files/file_hashes.txt

# Library files. package-lock.json is deliberately NOT ignored: the
# Dockerfile runs `npm ci`, which fails outright without a lockfile.
yarn.lock
pnpm-lock.yaml

# MQTT broker
# Nothing here is ignored: the broker image is built from this directory
# (Dockerfile, entrypoint, configs, ACL), so ignoring it meant a fresh clone
# could not build the broker at all.