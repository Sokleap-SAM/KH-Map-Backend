# dotenv environment variable files
# Ignore every .env variant, then re-allow the committed template. The broad
# pattern matters: `.env.production` holds real credentials and was not covered
# by the narrower `.env.production.local` rule below it.
.env
.env.*
!.env.example
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

